# Copy to .env and fill in your own values. Never commit the real .env.
# Get a key on your own Google account at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Required to enable status changes (acknowledge/resolve). Any long random string.
ADMIN_TOKEN=
# Optional overrides
DB_PATH=civicpulse.db
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=10
AI_DAILY_CALL_CAP=30
